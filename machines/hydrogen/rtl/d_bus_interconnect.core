CAPI=2:
name: :hydrogen:d_bus_interconnect
description: Hydrogen machine D-bus interconnect -- decode/translate/enable-gate/mux across BRAM and peripherals (see machines/hydrogen/docs/interconnect.md)

filesets:
  rtl:
    depend:
      - ":hydrogen:bus_if"
    files:
      - d_bus_interconnect.sv
    file_type: systemVerilogSource

  tb_cocotb:
    files:
      - tb/d_bus_interconnect_tb_top.sv
      - tb/test_d_bus_interconnect.py: {file_type: user, copyto: .}
    file_type: systemVerilogSource

  elab:
    files:
      - elab/d_bus_interconnect_elab_top.sv
    file_type: systemVerilogSource

targets:
  # Needed so other cores can depend on `:hydrogen:d_bus_interconnect` (see
  # e.g. the hydrogen machine top-level core).
  default:
    filesets: [rtl]

  lint:
    filesets: [rtl]
    toplevel: d_bus_interconnect
    flow: lint
    flow_options:
      tool: verilator

  # Always built with FST waveform tracing enabled -- see alu.core's
  # identical target.
  sim:
    filesets: [rtl, tb_cocotb]
    toplevel: d_bus_interconnect_tb_top
    flow: sim
    flow_options:
      tool: verilator
      cocotb_module: test_d_bus_interconnect
      verilator_options: [--trace-fst]
      run_options: [--trace]

  # Same sim, instrumented for line/branch/toggle coverage (CLAUDE.md's
  # Coverage decision) -- kept separate from `sim` so everyday runs stay
  # free of the coverage.dat side output. Drive via `just coverage`, which
  # also runs verilator_coverage --annotate over the result.
  coverage:
    filesets: [rtl, tb_cocotb]
    toplevel: d_bus_interconnect_tb_top
    flow: sim
    flow_options:
      tool: verilator
      cocotb_module: test_d_bus_interconnect
      verilator_options: [--trace-fst, --coverage-line, --coverage-toggle]
      run_options: [--trace]

  # `just elaborate` points Yosys (slang frontend) at these staged
  # sources -- see regfile.core's `elaborate` target for the full
  # rationale (why d_bus_interconnect_elab_top rather than
  # d_bus_interconnect_tb_top).
  elaborate:
    filesets: [rtl, elab]
    toplevel: d_bus_interconnect_elab_top
    flow: lint
    flow_options:
      tool: verilator
