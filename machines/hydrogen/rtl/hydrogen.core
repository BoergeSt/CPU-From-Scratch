CAPI=2:
name: :hydrogen:hydrogen
description: Hydrogen machine top-level -- wires core_glue, alu, alu_status, flow_ctl, regfile, bram, d_bus_interconnect, and uart together (see machines/hydrogen/docs/hydrogen.md)

filesets:
  rtl:
    depend:
      - ":hydrogen:isa_pkg"
      - ":hydrogen:flow_ctl"
      - ":hydrogen:alu"
      - ":hydrogen:alu_status"
      - ":hydrogen:bram"
      - ":hydrogen:regfile"
      - ":hydrogen:core_glue"
      - ":hydrogen:uart"
      - ":hydrogen:d_bus_interconnect"
    files:
      - hydrogen.sv: {file_type: systemVerilogSource}
      # See the waiver file itself for why this is only needed once
      # core_glue and bram are wired together for real, at this
      # machine-top level.
      - sim/hydrogen_bus_d_unoptflat.vlt: {file_type: vlt}

  elab:
    files:
      - elab/hydrogen_elab_top.sv
    file_type: systemVerilogSource

  # hydrogen_tb_top.sv isn't flattening interface ports like every other
  # module's tb_top.sv (hydrogen has none -- only clk_i/rst_i, already
  # plain); it exists solely to host the debug-only test-phase signal (see
  # the file itself). cocotb still reaches submodule state
  # (regfile.registers, bram.bram) hierarchically, just one level deeper
  # via .dut. now.
  tb_cocotb:
    files:
      - tb/hydrogen_tb_top.sv
      - tb/test_hydrogen.py: {file_type: user, copyto: .}
    file_type: systemVerilogSource

  # Separate from tb_cocotb: `run` loads an arbitrary assembled program
  # (path via $HYDROGEN_PROGRAM, see tb/run.py) rather than running the
  # fixed directed wiring-sanity tests -- kept apart so `just sim` stays
  # the fast, no-external-input directed suite.
  tb_run:
    files:
      - tb/run.py: {file_type: user, copyto: .}

  # Separate from tb_run: bridges uart0's real serial pins to a Unix
  # socket instead of running to a fixed cycle count -- see
  # hydrogen_interactive_harness.cpp and `just run-interactive`.
  # hydrogen_interactive_tb_top hosts the virtual RX/TX phys the harness
  # talks to (see that file for why -- moving UART bit-level timing into
  # Verilator instead of bit-banging it from software). Native C++ driver,
  # not cocotb -- see the `interactive` target below and the harness file's
  # header comment for why.
  tb_interactive:
    files:
      - tb/hydrogen_interactive_tb_top.sv: {file_type: systemVerilogSource}
      - tb/hydrogen_interactive_harness.cpp: {file_type: cppSource}

targets:
  # Needed so other cores can depend on `:hydrogen:hydrogen` (see e.g. a
  # future full-SoC top wiring in peripherals).
  default:
    filesets: [rtl]

  lint:
    filesets: [rtl]
    toplevel: hydrogen
    flow: lint
    flow_options:
      tool: verilator

  # Always built with FST waveform tracing enabled -- see alu.core's
  # identical target.
  sim:
    filesets: [rtl, tb_cocotb]
    toplevel: hydrogen_tb_top
    flow: sim
    flow_options:
      tool: verilator
      cocotb_module: test_hydrogen
      verilator_options: [--trace-fst]
      run_options: [--trace]

  # Same sim, instrumented for line/branch/toggle coverage (CLAUDE.md's
  # Coverage decision) -- kept separate from `sim` so everyday runs stay
  # free of the coverage.dat side output. Drive via `just coverage`, which
  # also runs verilator_coverage --annotate over the result.
  coverage:
    filesets: [rtl, tb_cocotb]
    toplevel: hydrogen_tb_top
    flow: sim
    flow_options:
      tool: verilator
      cocotb_module: test_hydrogen
      verilator_options: [--trace-fst, --coverage-line, --coverage-toggle]
      run_options: [--trace]

  # Loads and runs an arbitrary assembled program instead of the fixed
  # directed tb_cocotb suite -- see tb/run.py. Driven by `just run`, which
  # sets $HYDROGEN_PROGRAM (and optionally $HYDROGEN_CYCLES). Always
  # traced, same as `sim`, so `just view-run` has something to open.
  run:
    filesets: [rtl, tb_run]
    toplevel: hydrogen
    flow: sim
    flow_options:
      tool: verilator
      cocotb_module: run
      verilator_options: [--trace-fst]
      run_options: [--trace]

  # Open-ended interactive session, driven by `just run-interactive` --
  # see hydrogen_interactive_harness.cpp. No tracing: the session has no
  # fixed endpoint to review a waveform against, and the file would grow
  # unbounded. No cocotb_module: unlike every other sim target here, this
  # one builds and runs hydrogen_interactive_harness.cpp directly as a
  # plain Verilator C++ testbench -- see that file's header comment for
  # why (cocotb's own VPI/scheduler glue measured as the dominant
  # remaining bottleneck for this specific, non-verification target; a raw
  # C++ toggle loop over the same design measured ~13M cycles/sec vs.
  # cocotb's ~390k). sim/coverage/run stay on cocotb, unaffected.
  # Speed-optimized unlike the other sim targets above (which default to
  # Verilator's -Os/no-optimization for faster compile turnaround during
  # RTL iteration): an interactive session's compile happens once but then
  # runs for the whole session, so trading longer Verilator/g++ build time
  # for faster execution is the right call here specifically. -O3 is
  # Verilator's own model-scheduling optimization (verilator_options);
  # OPT_FAST/OPT_GLOBAL (make_options) separately control the GCC/Clang
  # optimization level used to compile Verilator's generated C++, which
  # defaults to -Os (see OSS CAD Suite's verilated.mk); CXX/LINK=clang++
  # measured a small but consistent win over GCC at this optimization
  # level. Runtime tuning (throttle rate, polling/reporting cadence) lives
  # in tb/interactive.conf, read fresh at startup -- no rebuild needed.
  interactive:
    filesets: [rtl, tb_interactive]
    toplevel: hydrogen_interactive_tb_top
    flow: sim
    flow_options:
      tool: verilator
      verilator_options: [-O3, --threads, "1"]
      make_options: [OPT_FAST=-O3, OPT_GLOBAL=-O3, CXX=clang++, LINK=clang++]

  # `just elaborate` points Yosys (slang frontend) at these staged
  # sources -- see regfile.core's `elaborate` target for the general
  # rationale. Needs hydrogen_elab_top rather than hydrogen directly:
  # hydrogen has no ports besides clk_i/rst_i, so opt would otherwise
  # prune the entire machine as unused.
  elaborate:
    filesets: [rtl, elab]
    toplevel: hydrogen_elab_top
    flow: lint
    flow_options:
      tool: verilator
