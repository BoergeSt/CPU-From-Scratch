CAPI=2:
name: :hydrogen:isa_pkg
description: Hydrogen machine ISA package -- instruction encoding types/enums (see docs/machines/hydrogen/isa.md)

filesets:
  rtl:
    files:
      - isa_pkg.sv
    file_type: systemVerilogSource

targets:
