CAPI=2:
name: :hydrogen:alu
description: Hydrogen machine ALU (see docs/machines/hydrogen/alu.md)

filesets:
  rtl:
    depend:
      - ":hydrogen:alu_if"
    files:
      - alu.sv
    file_type: systemVerilogSource

  tb_cocotb:
    files:
      - tb/alu_tb_top.sv
      - tb/test_alu.py: {file_type: user, copyto: .}
    file_type: systemVerilogSource

targets:
  # Needed so other cores can depend on `:hydrogen:alu` (see alu_if.core).
  default:
    filesets: [rtl]

  lint:
    filesets: [rtl]
    toplevel: alu
    flow: lint
    flow_options:
      tool: verilator

  # Always built with FST waveform tracing enabled -- measured no detectable
  # cost from leaving it on, so there's no separate untraced target to keep
  # in sync.
  sim:
    filesets: [rtl, tb_cocotb]
    toplevel: alu_tb_top
    flow: sim
    flow_options:
      tool: verilator
      cocotb_module: test_alu
      verilator_options: [--trace-fst]
      run_options: [--trace]
