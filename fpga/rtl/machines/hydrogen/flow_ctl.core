CAPI=2:
name: :hydrogen:flow_ctl
description: Hydrogen machine flow-control unit (see docs/machines/hydrogen/flow_ctl.md)

filesets:
  rtl:
    depend:
      - ":hydrogen:flow_ctl_if"
    files:
      - flow_ctl.sv
    file_type: systemVerilogSource

  tb_cocotb:
    files:
      - tb/flow_ctl_tb_top.sv
      - tb/test_flow_ctl.py: {file_type: user, copyto: .}
    file_type: systemVerilogSource

targets:
  # Needed so other cores can depend on `:hydrogen:flow_ctl` (see e.g. a
  # future control-unit core).
  default:
    filesets: [rtl]

  lint:
    filesets: [rtl]
    toplevel: flow_ctl
    flow: lint
    flow_options:
      tool: verilator

  # Always built with FST waveform tracing enabled -- see alu.core's
  # identical target.
  sim:
    filesets: [rtl, tb_cocotb]
    toplevel: flow_ctl_tb_top
    flow: sim
    flow_options:
      tool: verilator
      cocotb_module: test_flow_ctl
      verilator_options: [--trace-fst]
      run_options: [--trace]

  # Same sim, instrumented for line/branch/toggle coverage (CLAUDE.md's
  # Coverage decision) -- kept separate from `sim` so everyday runs stay
  # free of the coverage.dat side output. Drive via `just coverage`, which
  # also runs verilator_coverage --annotate over the result.
  coverage:
    filesets: [rtl, tb_cocotb]
    toplevel: flow_ctl_tb_top
    flow: sim
    flow_options:
      tool: verilator
      cocotb_module: test_flow_ctl
      verilator_options: [--trace-fst, --coverage-line, --coverage-toggle]
      run_options: [--trace]
